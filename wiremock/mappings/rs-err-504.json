{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPattern": "/auth|/doAction",
    "bodyPatterns": [
      {
        "matches": ".*token=[0-9A-Z]*BAD504(&.*|$)"
      }
    ]
  },
  "response": {
    "status": 504,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "result": "ERROR",
      "message": "Gateway Timeout"
    }
  }
}